# OneRec paper-code release ignore policy
#
# Keep source code, configs, tests, and minimal public-facing README files.
# Keep research notebooks/notes, advisor reports, registries, large/raw data,
# model weights, local logs, temporary shards, and private agent/editor state
# out of git for a clean paper-style open-source repository.

# Python caches and test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Build and packaging
build/
dist/
site/
*.egg-info/
.eggs/

# Virtual environments and local Python version pins
.env
.venv/
venv/
env/
ENV/
conda-meta/
.python-version

# Editors, OS files, and local agent/private state
.vscode/
.idea/
.DS_Store
Thumbs.db
.codex
.codex/
.claude/
AGENTS.md
.claude/settings.local.json
.claude/skills/

# TeX build artifacts
*.tex
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
missfont.log

# Draft docs and internal notes. Keep only the public root README by default.
*.md
!README.md

# Runtime logs, caches, and temporary evaluation shards
logs/
log/
wandb/
.cache/
temp/
tmp/

# Training, evaluation, and model outputs
output/
outputs/
output_weights/
checkpoints/
runs/

# Result payloads can be large; keep release metrics in curated tables/README
# when needed, not in raw evaluation JSON.
results/
idea-discovery/**/mainline/results/

# Model and optimizer artifacts
*.pt
*.pth
*.ckpt
*.bin
*.safetensors

# Raw/downloaded/generated data
raw_data/
data/Amazon14/
data/Amazon18/
data/Amazon23/
data/Amazon14_Processed/
data/**/.cache/
data/**/*.npy

# Keep curated Amazon artifacts that are already part of the repository.
!data/Amazon/
!data/Amazon/**

# Runtime dataset caches under curated Amazon artifacts
data/Amazon/**/.cache/
data/Amazon/**/.cache/**

# Generated experiment datasets: existing tracked files remain tracked, but new
# converted variants should be recorded through scripts/registries, not added by
# accident.
data_experiment/**/.cache/
data_experiment/**/*.npy

# Internal research work logs, draft reports, and exploration branches.
research-progress-log/
idea-discovery/
legacy_experiment_results.csv
experiment_results.csv
sid_diagnostic_results.csv
DOCUMENTATION_MAINTENANCE_WORKFLOW.md
PROJECT_WORKSPACE_MAP.md

# Local downloaded papers and paper-reading notes.
papers/**/*.pdf
papers/**/*.PDF
papers/

# Keep small fixtures used by unit tests
!tests/fixtures/
!tests/fixtures/**
